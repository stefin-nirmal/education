{
  "name": "EduVision Modern Dark",
  "dataColors": [
    "#7C5CFC",
    "#3B82F6",
    "#06B6D4",
    "#10B981",
    "#F59E0B",
    "#EC4899",
    "#8B5CF6",
    "#6366F1",
    "#14B8A6",
    "#F97316",
    "#A855F7",
    "#38BDF8"
  ],
  "background": "#0B0E1B",
  "foreground": "#FFFFFF",
  "tableAccent": "#7C5CFC",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#0B0E1B" } },
            "foregroundColor": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1B1F38" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#282F54" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 70
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "Left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#94A3B8" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0B0E1B" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 20
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#94A3B8" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "cardTitle": [
          {
            "color": { "solid": { "color": "#7C5CFC" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11
          }
        ],
        "dataLabels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 18
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#94A3B8" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#E2E8F0" } },
            "background": { "solid": { "color": "#16192E" } },
            "fontFamily": "Segoe UI",
            "textSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#23294C" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#E2E8F0" } },
            "backColorPrimary": { "solid": { "color": "#1B1F38" } },
            "fontColorSecondary": { "solid": { "color": "#E2E8F0" } },
            "backColorSecondary": { "solid": { "color": "#161A30" } },
            "fontFamily": "Segoe UI",
            "fontSize": 8.5
          }
        ],
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": { "solid": { "color": "#282F54" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#282F54" } }
          }
        ]
      }
    }
  }
}
